<% guide = StartGuide.new(current_workspace) %>
<section class="start-guide" aria-labelledby="start-guide-title">
  <% if guide.finished? %>
    <h2 id="start-guide-title">Deine ersten Schritte sind erledigt</h2>
    <p>Diese Checkliste ist eine Orientierung für den Einstieg. Buchhaltung, Aufbewahrung und die Prüfung deiner Pflichten bleiben laufende Aufgaben.</p>
  <% else %>
    <% step = guide.current %>
    <p class="eyebrow">Schritt <%= guide.position(step) %> von <%= guide.steps.size %></p>
    <h2 id="start-guide-title"><%= step.title %></h2>
    <p><%= step.text %></p>
    <div class="start-guide__actions">
      <% if step.link_path %>
        <%= link_to button_label(step.link_text, icon: :forward), public_send(step.link_path), class: "button button--primary" %>
      <% end %>
      <% unless step.key == "rechnung" %>
        <%= button_to button_label("Das habe ich erledigt", icon: :check), start_step_path(step.key), method: :patch, class: "button #{step.link_path ? 'button--secondary' : 'button--primary'}", form: { class: "start-guide__form" } %>
      <% end %>
    </div>
  <% end %>
  <details class="start-guide__all">
    <summary>Alle Schritte ansehen</summary>
    <ol>
      <% guide.steps.each do |step| %>
        <li class="<%= "is-done" if guide.done?(step) %>">
          <%= guide.done?(step) ? "✓" : "○" %> <%= step.title %>
          <% if step.key != "rechnung" && guide.done?(step) %>
            <%= button_to button_label("zurücknehmen", icon: :undo), start_step_path(step.key), method: :patch, class: "start-guide__undo", form: { class: "start-guide__form" } %>
          <% end %>
        </li>
      <% end %>
    </ol>
  </details>
</section>
