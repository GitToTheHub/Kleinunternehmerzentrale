<% content_for :title, "Konto anlegen" %>

<main>
  <h1>Konto anlegen</h1>
  <p>Mit einem Konto bleiben deine Daten dauerhaft gespeichert und du erreichst sie auch auf anderen Geräten. Alles, was du bisher eingegeben hast, wird automatisch übernommen.</p>

  <% if @workspace&.errors&.any? %>
    <div class="flash-message flash-message--alert" role="alert">
      <% @workspace.errors.full_messages.each do |message| %><div><%= message %></div><% end %>
    </div>
  <% end %>

  <%= form_with url: account_path, method: :post, class: "account-form", data: { turbo: false } do %>
    <div class="field">
      <label for="email">E-Mail-Adresse</label>
      <input type="email" id="email" name="email" value="<%= params[:email] %>" autocomplete="email" required>
    </div>
    <div class="field">
      <label for="password">Passwort</label>
      <input type="password" id="password" name="password" autocomplete="new-password" minlength="10" required>
      <small>Mindestens 10 Zeichen.</small>
    </div>
    <div class="field">
      <label for="password_confirmation">Passwort wiederholen</label>
      <input type="password" id="password_confirmation" name="password_confirmation" autocomplete="new-password" required>
    </div>
    <p><small>Wir nutzen deine E-Mail-Adresse nur für die Anmeldung. Mehr dazu in der <%= link_to "Datenschutzerklärung", datenschutz_path %>.</small></p>
    <p><%= submit_tag "Konto anlegen", class: "button button--primary", data: { disable_with: false } %></p>
  <% end %>

  <p>Du hast schon ein Konto? <%= link_to "Anmelden", new_session_path %></p>
</main>
