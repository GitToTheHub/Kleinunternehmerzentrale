<% content_for :title, @invoice.invoice_number %>
<main>
  <% if @preview %>
    <div class="invoice-preview-banner no-print" role="status">
      <strong>Vorschau</strong> Diese Rechnung ist noch nicht erstellt. Die Rechnungsnummer ist vorläufig.
      <% unless @embedded_preview %><button type="button" class="button button--secondary" onclick="window.close()"><%= button_label("Vorschau schließen", icon: :cancel) %></button><% end %>
    </div>
    <% free_positions = @invoice.invoice_lines.each_with_index.filter_map { |line, index| index + 1 if line.unit_price.zero? } %>
    <% if free_positions.any? %>
      <p class="invoice-status invoice-preview-warning no-print" role="status">Achtung: Preis von <%= invoice_money(0, @invoice) %> in <%= free_positions.one? ? "Position" : "Positionen" %> <%= free_positions.to_sentence %>. Bitte prüfe die Preise vor dem Festschreiben.</p>
    <% end %>
  <% else %>
  <% if flash[:first_invoice] %>
    <aside class="first-invoice-tip no-print">
      <h2>Deine erste Rechnung – gut gemacht! 🎉</h2>
      <p><strong>Zwei Dinge noch:</strong> Speichere die Rechnung auf deinem Gerät und schicke sie deiner Kundin oder deinem Kunden. Bei Versand als E-Rechnung musst du die XML-Datei aufbewahren; eine zusätzliche PDF ersetzt sie nicht. Bei einer reinen PDF-Rechnung speicherst du die PDF.</p>
      <p>Hebe die Datei 8 Jahre lang unverändert auf. Das ist Pflicht, aber ganz einfach: ein Ordner genügt.</p>
      <p class="first-invoice-tip__donate">Hat dir die Kleinunternehmerzentrale geholfen? Sie ist kostenlos und lebt von Spenden (die für den Betreiber steuerpflichtiges Einkommen sind). <%= link_to "Mehr dazu", spenden_path %></p>
    </aside>
  <% end %>
  <% if @invoice.cancellation? %>
    <p class="invoice-status no-print">Das ist eine Stornorechnung zu <%= link_to @invoice.cancelled_invoice.invoice_number, invoice_path(@invoice.cancelled_invoice) %>.</p>
  <% elsif @invoice.cancellation %>
    <p class="invoice-status no-print">Diese Rechnung ist storniert durch <%= link_to @invoice.cancellation.invoice_number, invoice_path(@invoice.cancellation) %>.
      <% if @correction_invoice %>
        Korrigiert durch <%= link_to @correction_invoice.invoice_number, invoice_path(@correction_invoice) %>.
      <% elsif @correction_draft %>
        <%= link_to "Korrekturentwurf weiterbearbeiten", edit_draft_invoices_path(draft_id: @correction_draft.id) %>
      <% else %>
        <%= link_to "Korrigierte Rechnung erstellen", new_invoice_path(copy_from: @invoice.id) %>
      <% end %>
    </p>
  <% end %>
  <% if @invoice.corrected_invoice %>
    <p class="invoice-status no-print">Diese Rechnung korrigiert <%= link_to @invoice.corrected_invoice.invoice_number, invoice_path(@invoice.corrected_invoice) %>.</p>
  <% end %>
  <section class="invoice-panel no-print" aria-label="Zahlungsstatus">
    <h2><%= @invoice.payment_status %></h2>
    <% if @invoice.payment_entry %>
      <p>Zahlungseingang am <%= @invoice.payment_entry.paid_on.strftime("%d.%m.%Y") %>: <%= number_to_currency(@invoice.payment_entry.amount, locale: :de) %>.</p>
      <%= link_to button_label("Zahlung in der EÜR bearbeiten", icon: :edit), edit_bookkeeping_entry_path(@invoice.payment_entry), class: "button button--secondary" %>
    <% elsif @invoice.payment_recordable? %>
      <p><%= @invoice.paid? ? "Die Rechnung wurde bereits als bezahlt ausgestellt. Erfasse den Zahlungseingang für die EÜR." : "Diese Rechnung ist noch nicht als bezahlt erfasst. Der Zahlungseingang wird beim Speichern in die EÜR übernommen." %></p>
      <%= link_to button_label(@invoice.paid? ? "Zahlung in EÜR erfassen" : "Als bezahlt markieren", icon: :check), new_bookkeeping_entry_path(invoice_id: @invoice.id), data: { action: "payment-dialog#open" }, aria: { haspopup: "dialog" }, class: "button button--primary" %>
    <% end %>
  </section>
  <% if @invoice.sales_document_id %><p class="no-print">Auftrag: <%= link_to @invoice.sales_document.document_number, @invoice.sales_document %></p><% end %>
  <% if @invoice.staged_invoice? && !@invoice.cancellation? %>
    <section class="invoice-panel no-print" aria-label="Auftrag und Teilrechnungen">
      <h2>Rechnungen zu diesem Auftrag</h2>
      <ul><% @invoice.order_invoices.order(:issued_on, :id).each do |related| %>
        <li><%= link_to "#{related.billing_label} #{related.invoice_number}", invoice_path(related) %> · <%= related.payment_status %></li>
      <% end %></ul>
      <% if @invoice.partial_invoice? && (settled_final = @invoice.active_final_invoice) && !@invoice.base_order_invoices.exists?(id: settled_final.id) %>
        <p>Angerechnet in <%= link_to "Schlussrechnung #{settled_final.invoice_number}", invoice_path(settled_final) %>.</p>
      <% end %>
      <% unless @invoice.active_final_invoice %>
        <%= link_to button_label("Weitere Anzahlung erstellen", icon: :add), new_invoice_path(**(@invoice.sales_document_id ? { sales_document_id: @invoice.sales_document_id } : { billing_root_id: @invoice.billing_root_id_for_order }), billing_kind: "advance"), class: "button button--secondary" %>
        <%= link_to button_label("Abschlagsrechnung erstellen", icon: :add), new_invoice_path(**(@invoice.sales_document_id ? { sales_document_id: @invoice.sales_document_id } : { billing_root_id: @invoice.billing_root_id_for_order }), billing_kind: "progress"), class: "button button--secondary" %>
        <%= link_to button_label("Schlussrechnung erstellen", icon: :add), new_invoice_path(**(@invoice.sales_document_id ? { sales_document_id: @invoice.sales_document_id } : { billing_root_id: @invoice.billing_root_id_for_order }), billing_kind: "final"), class: "button button--primary" %>
      <% end %>
    </section>
  <% end %>
  <div class="invoice-actions no-print">
    <%= link_to button_label("Alle Rechnungen", icon: :back), invoices_path, class: "button button--secondary" %>
    <button type="button" class="button button--primary" data-controller="print" data-action="print#print"><%= button_label("Drucken oder als PDF speichern", icon: :print) %></button>
    <% if @invoice.seller_email.present? && @invoice.buyer_email.present? %>
      <%= link_to button_label("XRechnung herunterladen (XML)", icon: :download), xrechnung_invoice_path(@invoice), class: "button button--secondary", download: "#{@invoice.invoice_number}.xml", data: { turbo: false } %>
    <% else %>
      <span class="invoice-email-requirement">Für eine XRechnung müssen E-Mail-Adressen für beide Seiten eingetragen sein.</span>
    <% end %>

  </div>
  <% end %>

    <% unless @preview %>
    <aside class="no-print invoice-panel invoice-hint invoice-action-hints" aria-label="Hinweise zur Rechnung">
      <h2>Hinweise zur Rechnung</h2>
      <ul>
      <li><strong>E-Rechnung:</strong> Als Kleinunternehmer musst du nach den umsatzsteuerlichen Regeln keine E-Rechnung ausstellen. Papier oder mit Zustimmung des Empfängers eine PDF sind weiterhin möglich. Wenn du freiwillig eine E-Rechnung senden möchtest, lade die XML-Datei herunter und sende sie an deinen Kunden. Entscheidend ist das Format, das du als Rechnung versendest: Versendest du nur die PDF, ist sie die maßgebliche Rechnung. Versendest du XML und eine inhaltsgleiche PDF zusammen als E-Rechnung, ist die XML-Datei maßgeblich und unverändert aufzubewahren; die PDF dient als zusätzliche Ansicht. Das bloße Erstellen oder Herunterladen einer XML-Datei ändert eine versendete PDF-Rechnung nicht. <%= link_to "Quelle: Bundesfinanzministerium", "https://www.bundesfinanzministerium.de/Content/DE/FAQ/e-rechnung.html", target: "_blank", rel: "noopener" %></li>
      <% unless @invoice.cancellation? || @invoice.cancellation %>
        <li class="invoice-correction-hint"><strong>Fehler auf der Rechnung?</strong> Falls eine Korrektur nötig ist, kannst du die Rechnung mit dem folgenden Button stornieren und korrigieren. Dabei wird die Rechnung aufgehoben und eine Vorlage für die korrigierte Rechnung geöffnet. Schicke anschließend die Stornorechnung und die neue Rechnung an deinen Kunden.
          <%= button_to button_label("Rechnung stornieren und korrigieren", icon: :undo), cancel_invoice_path(@invoice), class: "button button--secondary", form: { class: "invoice-correction-hint__action", data: { turbo_confirm: "Wirklich stornieren? Es wird eine Stornorechnung erstellt. Das lässt sich nicht rückgängig machen." } } %>
        </li>
      <% end %>
      </ul>
    </aside>
    <% end %>

  <% if @invoice.foreign_currency? %>
    <p class="form-note no-print invoice-euro-conversion">Für deine Umsatzübersicht: <%= number_to_currency(@invoice.total_in_euros, unit: "€", format: "%n %u", locale: :de) %>.
      Kurs: 1 <%= @invoice.currency %> = <%= @invoice.exchange_rate.to_s("F") %> EUR, vom <%= @invoice.exchange_rate_on.strftime("%d.%m.%Y") %>, Quelle: <%= @invoice.exchange_rate_source %>.</p>
  <% end %>
  <div class="invoice-sheet-preview" data-controller="invoice-pagination" data-action="turbo:before-cache@document->invoice-pagination#teardown">
  <p class="no-print form-note" role="status" data-invoice-pagination-target="status">Seitenvorschau wird vorbereitet …</p>
  <article class="print-invoice" data-invoice-pagination-target="source">
    <header class="print-invoice__header">
      <p class="print-invoice__return-address"><%= @invoice.seller_name %> · <%= @invoice.seller_street %> · <%= @invoice.seller_postal_code %> <%= @invoice.seller_city %></p>
      <section class="print-invoice__recipient" aria-label="Rechnungsempfänger">
        <div class="print-invoice__recipient-address">
        <strong><%= @invoice.buyer_name %></strong><br>
        <% if @invoice.buyer_contact_name.present? %><%= @invoice.buyer_contact_name %><br><% end %>
        <%= @invoice.buyer_street %><br>
        <%= @invoice.buyer_postal_code %> <%= @invoice.buyer_city %>
        <% if @invoice.buyer_country != "DE" %><br><%= Invoice::COUNTRIES.rassoc(@invoice.buyer_country)&.first %><% end %>
        </div>
      </section>
      <div class="print-invoice__seller">
        <strong><%= @invoice.seller_name %></strong><br>
        <%= @invoice.seller_street %><br>
        <%= @invoice.seller_postal_code %> <%= @invoice.seller_city %><br>
        <%= Invoice::COUNTRIES.rassoc(@invoice.seller_country)&.first %><br>
        <% if @invoice.seller_email.present? %><%= @invoice.seller_email %><br><% end %>
        <% if @invoice.seller_phone.present? %>Telefon: <%= @invoice.seller_phone %><br><% end %>
        <%= @invoice.seller_tax_id_kind == "vat_id" ? "Umsatzsteuer-ID" : "Steuernummer" %>: <%= @invoice.seller_tax_identifier %>
      </div>
    </header>

    <div class="print-invoice__title">
      <p class="eyebrow"><%= @invoice.cancellation? ? "Stornorechnung" : (@invoice.corrected_invoice ? (@invoice.staged_invoice? ? "Korrekturrechnung · #{@invoice.billing_label}" : "Korrekturrechnung") : @invoice.billing_label) %></p>
      <h1><%= @invoice.invoice_number %></h1>
      <% if @invoice.title.present? %><p class="print-invoice__subject"><%= @invoice.title %></p><% end %>
      <% if @invoice.correction_notice.present? %><p class="print-invoice__correction"><%= @invoice.correction_notice %></p><% end %>
    </div>

    <% if @invoice.cancellation? %>
      <p class="invoice-cancellation-note">Diese Stornorechnung hebt die Rechnung <strong><%= @invoice.cancelled_invoice.invoice_number %></strong> vom <%= @invoice.cancelled_invoice.issued_on.strftime("%d.%m.%Y") %> auf.</p>
    <% end %>



    <% if @invoice.partial_invoice? %>
      <p><%= @invoice.billing_kind == "advance" ? "Anzahlung auf die unten aufgeführten Positionen." : "Abschlagszahlung für den beschriebenen Arbeitsstand. Der Auftrag wird später mit einer Schlussrechnung abgerechnet." %></p>
    <% end %>
    <dl class="invoice-meta">
      <div><dt>Rechnungsdatum</dt><dd><%= @invoice.issued_on.strftime("%d.%m.%Y") %></dd></div>
      <% if @invoice.service_until_on? %>
        <div><dt><%= @invoice.billing_kind == "advance" ? "Voraussichtlicher Leistungszeitraum" : "Leistungszeitraum" %></dt><dd><%= @invoice.service_on.strftime("%d.%m.%Y") %> bis <%= @invoice.service_until_on.strftime("%d.%m.%Y") %></dd></div>
      <% else %>
        <div><dt><%= @invoice.billing_kind == "advance" ? "Voraussichtliche Leistung" : "Leistungsdatum" %></dt><dd><%= @invoice.service_on.strftime("%d.%m.%Y") %></dd></div>
      <% end %>
      <% if @invoice.buyer_order_number.present? %><div><dt>Bestellnummer</dt><dd><%= @invoice.buyer_order_number %></dd></div><% end %>
      <% if @invoice.buyer_leitweg_id.present? %><div><dt>Leitweg-ID</dt><dd><%= @invoice.buyer_leitweg_id %></dd></div><% end %>
    </dl>

    <% if @invoice.order_total && @invoice.partial_invoice? && !@invoice.cancellation? && !invoice_scope_positions?(@invoice) %>
      <p class="invoice-order-summary">Vereinbarter Gesamtpreis: <strong><%= invoice_money(@invoice.order_total, @invoice) %></strong><br>Diese <%= @invoice.billing_label %>: <strong><%= invoice_money(@invoice.total, @invoice) %></strong><% if @invoice.allocation_mode == "percent" %> (<%= number_with_precision(@invoice.allocation_percent, precision: 2, strip_insignificant_zeros: true, locale: :de) %> %)<% end %></p>
    <% end %>
    <%= render "invoices/table" %>

    <% unless @invoice.standard_taxed? %>
    <p class="invoice-tax-note">Keine Umsatzsteuer ausgewiesen. Es gilt die Steuerbefreiung für Kleinunternehmer <span class="invoice-tax-note__reference">(<%= link_to "§ 19 UStG", "https://www.gesetze-im-internet.de/ustg_1980/__19.html", target: "_blank", rel: "noopener" %>).</span></p>
    <% end %>
    <% if !@invoice.payment_total.zero? && (@invoice.paid? || @invoice.effective_payment_method == "cash" || @invoice.iban.present? || @invoice.payment_due_on || @invoice.payment_terms.present?) %>
      <section class="invoice-payment">
        <h2>Zahlung</h2>
        <% if @invoice.paid? && !@invoice.cancellation? %><p><strong>Bereits vollständig bezahlt<%= " (bar)" if @invoice.effective_payment_method == "cash" %>.</strong></p><% elsif @invoice.effective_payment_method == "cash" %><p>Zahlungsart: Barzahlung.</p><% end %>
        <% if @invoice.payment_due_on && !@invoice.paid? && @invoice.payment_total.positive? %><p>Bitte den Betrag bis zum <strong><%= l(@invoice.payment_due_on, format: "%d.%m.%Y") %></strong> bezahlen.</p><% end %>
        <% if @invoice.iban.present? && @invoice.effective_payment_method == "transfer" && !@invoice.paid? && @invoice.payment_total.positive? %>
          <p>Kontoinhaber: <%= @invoice.seller_name %><br>IBAN: <strong><%= @invoice.iban.scan(/.{1,4}/).join(" ") %></strong><% if @invoice.bic.present? %><br>BIC: <%= @invoice.bic %><% end %><br>Verwendungszweck: <%= @invoice.invoice_number %></p>
        <% end %>
        <% if @invoice.payment_terms.present? %><p><%= @invoice.payment_terms %></p><% end %>
      </section>
    <% end %>

  </article>
  <div class="invoice-pages invoice-pages--rendering" data-invoice-pagination-target="pages"></div>
  </div>



</main>
