      <div class="bookkeeping-table bookkeeping-entries-table"><table><thead><tr><th scope="col">Datum</th><th scope="col">Art / Beleg</th><th scope="col">Beschreibung</th><th scope="col">Betrag</th><th scope="col">Aktionen</th></tr></thead><tbody>
        <% entries.each do |entry| %><tr>
          <td><%= entry.paid_on.strftime("%d.%m.%Y") %><% if entry.tax_year %><br>Steuerjahr <%= entry.tax_year %><% end %></td>
          <td><%= BookkeepingEntry::KINDS.fetch(entry.kind) %><br><%= entry.reference %><% if entry.effective_category %><br><small><%= BookkeepingEntriesHelper::EVERYDAY_CATEGORIES.fetch(entry.effective_category, EuerFields::DEFINITIONS.fetch(entry.effective_category).label) %></small><% end %></td>
          <td><%= entry.description %><% if entry.original_entry %><br><small>Rückzahlung zu: <%= entry.original_entry.description %></small><% elsif entry.refunds.any? %><br><small>Zurückgezahlt: <%= euro(entry.refunds.sum(:amount)) %></small><% end %><% if entry.invoice %><br><%= link_to "Rechnung #{entry.invoice.invoice_number} · #{entry.invoice.payment_status}", invoice_path(entry.invoice) %><% end %></td><td><%= euro(entry.signed_amount) %><% if entry.kind == "expense" && entry.business_percent < 100 %><br><small><%= entry.business_percent %> % betrieblich: <%= euro(entry.business_amount) %><br><%= entry.usage_notes %></small><% end %><% if entry.payment_account == "private" && %w[income expense].include?(entry.kind) %><br><small>Privatkonto</small><% end %></td>
          <td><div class="bookkeeping-entry-actions"><% if entry.refundable? %><%= link_to entry.kind == "income" ? "Geld zurückzahlen" : "Erstattung erfassen", refund_bookkeeping_entry_path(entry) %><% end %><%= link_to "Bearbeiten", edit_bookkeeping_entry_path(entry) %><%= button_to "Löschen", bookkeeping_entry_path(entry), method: :delete, class: "button button--danger", data: { turbo_confirm: entry.invoice ? "Zahlung löschen? Die Verknüpfung zur Rechnung wird entfernt und ihr Zahlungsstatus neu ermittelt." : "Diesen Vorgang löschen?" } %></div></td>
        </tr><% end %>
      </tbody></table></div>
