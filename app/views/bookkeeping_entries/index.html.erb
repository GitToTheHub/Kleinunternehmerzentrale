<% content_for :title, "Meine Buchhaltung" %>
<main>
  <h1>Meine Buchhaltung</h1>
  <%= form_with url: bookkeeping_entries_path, method: :get, class: "bookkeeping-year-filter", data: { controller: "auto-submit", action: "change->auto-submit#submit" } do |form| %>
    <div class="field"><%= form.label :year, "Kalenderjahr" %><%= form.select :year, @available_years, { selected: @year, include_blank: false } %></div>
  <% end %>
  <%= render "overview" %>
  <p><%= link_to "Buchhaltung im Alltag: Belege, private Zahlungen und gemischte Kosten", hilfe_path(anchor: "buchhaltung-im-alltag") %></p>
  <div class="invoice-actions">
    <%= link_to "Neue Buchung", new_bookkeeping_entry_path, class: "button button--primary" %>
    <%= link_to "Anlageverzeichnis", business_assets_path, class: "button button--secondary" %>
    <%= link_to "Bisherige Buchhaltung übernehmen", new_bookkeeping_import_path, class: "button button--secondary" %>
    <%= link_to "EÜR für ELSTER vorbereiten", prepare_euer_bookkeeping_entries_path(year: @year), class: "button button--secondary" %>
  </div>
  <% @report.warnings.each do |message| %><div class="flash-message flash-message--alert" role="status"><%= message %></div><% end %>
  <%= render "imports" %>
  <h2>Erfasste Buchungen <%= @year %></h2>
  <p>Privat bezahlte betriebliche Kosten werden automatisch auch als Einlage berücksichtigt. Solche Geldbewegungen erscheinen mit einem Link zu ihrer Quelle; du brauchst sie nur einmal zu erfassen.</p>
  <% BookkeepingEntriesHelper::BOOKING_ACTIONS.each do |kind, action| %>
    <section id="<%= kind %>">
      <h2><%= action.fetch(:title) %></h2>
      <% entries = @report.entries.select { |entry| entry.kind == kind } %>
      <% movements = %w[deposit withdrawal].include?(kind) ? @report.automatic_money_movements(kind) : [] %>
      <% if entries.any? %><%= render "entries", entries: entries %><% elsif movements.empty? %><p>Noch keine Vorgänge in dieser Tabelle.</p><% end %>
      <% if movements.any? %>
        <p>Aus deinen Zahlungen automatisch berücksichtigt. Bearbeite bei Bedarf die ursprüngliche Zahlung; lege hierfür keinen weiteren Vorgang an.</p>
        <div class="bookkeeping-table bookkeeping-movements-table"><table><thead><tr><th>Datum</th><th>Beschreibung</th><th>Betrag</th><th>Herkunft</th></tr></thead><tbody>
          <% movements.each do |movement| %><tr><td data-label="Datum"><%= movement[:date].strftime("%d.%m.%Y") %></td><td data-label="Beschreibung"><%= movement[:description] %></td><td data-label="Betrag"><%= euro(movement[:amount]) %></td><td data-label="Herkunft"><%= link_to "Ursprung bearbeiten", movement[:source].is_a?(BusinessAsset) ? edit_business_asset_path(movement[:source]) : edit_bookkeeping_entry_path(movement[:source]) %></td></tr><% end %>
        </tbody></table></div>
      <% end %>
    </section>
  <% end %>
  <%= render "assets" %>
  <%= render "adjustments" %>
</main>
