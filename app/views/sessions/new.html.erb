<% content_for :title, "Anmelden" %>

<main>
  <h1>Anmelden</h1>
  <p>Melde dich an, um auf deine gespeicherten Rechnungen zuzugreifen.</p>

  <%= form_with url: session_path, method: :post, class: "account-form", data: { turbo: false } do %>
    <div class="field">
      <label for="email">E-Mail-Adresse</label>
      <input type="email" id="email" name="email" value="<%= params[:email] %>" autocomplete="email" required>
    </div>
    <div class="field">
      <label for="password">Passwort</label>
      <input type="password" id="password" name="password" autocomplete="current-password" required>
    </div>
    <p><%= submit_tag "Anmelden", class: "button button--primary", data: { disable_with: false } %></p>
  <% end %>

  <p>Noch kein Konto? <%= link_to "Konto anlegen", new_account_path %></p>
</main>
